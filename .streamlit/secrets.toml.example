# .streamlit/secrets.toml
# In locale: crea questo file (e' in .gitignore).
# Su Streamlit Cloud: App settings -> Secrets, stesso contenuto.

[postgres]
host     = "swim-swim-project.e.aivencloud.com"
port     = 17236
dbname   = "defaultdb"
user     = "avnadmin"
password = "LA_TUA_PASSWORD"
# CA cert opzionale: vuoto -> sslmode=require (cifrato, senza verifica CA).
# Per verify-ca incolla il contenuto del ca.pem scaricato dalla console Aiven.
sslrootcert = ""


[app]
# "code"  -> codice FIN + data di nascita (default, nessun provider esterno)
# "oidc"  -> st.login() con un provider OpenID Connect, mappa athletes.email
# "open"  -> nessun login, solo per sviluppo
auth_mode = "code"

# Chiave per firmare il token "resta connesso". Cambiala e tienila segreta.
token_secret = "cambia-questa-stringa-lunga-e-casuale"

# ── Ruoli ─────────────────────────────────────────────────────────
# Admin e allenatori scelgono qualsiasi atleta dalla barra laterale;
# tutti gli altri vedono la propria scheda.
#
# Tre modi per indicare una persona, vale il primo che corrisponde:
#   *_athlete_ids  athletes.id, il piu' stabile, non cambia mai
#   *_fin_codes    codice FIN, comodo perche' e' quello che si ricorda
#   *_emails       SOLO con auth_mode = "oidc": in modalita' "code"
#                  l'email non viene mai chiesta, quindi non scatta
#
# Esempio: Modenese Mirko e' athlete_id 52, codice FIN 281728.
admin_athlete_ids = [52]
admin_fin_codes   = []
admin_emails      = []

coach_athlete_ids = []
coach_fin_codes   = []
coach_emails      = []


# Solo con auth_mode = "oidc". Esempio con Google:
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "un-altra-stringa-lunga-e-casuale"
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
